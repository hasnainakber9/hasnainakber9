    {"id": "s08", "beat": "Shared meal", "duration": 10.0, "env": "kitchen",
     "lines": [["NOOR", "So this came from the farm?", 2.0], ["ASHA", "That, the greenhouse, and about six people you didn't see.", 4.6]]},
    {"id": "s09", "beat": "Loop closes", "duration": 8.0, "env": "loop",
     "lines": [["NOOR", "And the scraps?", 1.2], ["ASHA", "Back to the soil.", 3.2]]},
    {"id": "s10", "beat": "Return to table", "duration": 6.5, "env": "kitchen",
     "lines": [["NOOR", "Okay. Not ugly.", 1.4], ["ASHA", "High praise.", 3.9]]},
