    {"id": "s05", "beat": "Food science", "duration": 8.0, "env": "lab",
     "lines": [["COLLEAGUE", "Protein... from microbes?", 1.4], ["MAYA", "Yogurt is microbes.", 3.9], ["COLLEAGUE", "Fair.", 6.2]]},
    {"id": "s06", "beat": "Logistics", "duration": 9.0, "env": "hub",
