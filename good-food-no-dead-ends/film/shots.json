  "shots": [
    {"id": "s01", "beat": "Tomato hook", "duration": 6.0, "env": "kitchen",
     "lines": [["NOOR", "This one's ugly.", 0.8], ["ASHA", "It's a tomato, not a job interview.", 2.6]]},
    {"id": "s02", "beat": "Farm and neighbours", "duration": 8.5, "env": "farm",
     "lines": [["ASHA", "Storm's two hours early.", 0.9], ["LUIS", "Then so are we.", 2.6], ["ASHA", "Six of us against that?", 4.3], ["LUIS", "Forty neighbours said yes.", 6.2]]},
    {"id": "s03", "beat": "Harvest and resilience", "duration": 7.5, "env": "harvest", "lines": []},
    {"id": "s04", "beat": "City growing", "duration": 8.0, "env": "greenhouse",
