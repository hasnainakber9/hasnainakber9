 "dialogue": [
  {
   "char": "NOOR",
   "text": "This one's ugly.",
   "start": 0.8,
   "end": 2.016,
   "clip": "s01_0_NOOR.wav"
  },
  {
   "char": "ASHA",
   "text": "It's a tomato, not a job interview.",
   "start": 2.6,
   "end": 4.739,
   "clip": "s01_1_ASHA.wav"
  },
  {
   "char": "ASHA",
   "text": "Rain's coming early.",
   "start": 6.9,
   "end": 8.279,
   "clip": "s02_0_ASHA.wav"
  },
  {
   "char": "LUIS",
   "text": "The forecast updated.",
   "start": 8.629,
   "end": 10.07,
   "clip": "s02_1_LUIS.wav"
  },
  {
   "char": "ASHA",
   "text": "It doesn't know this soil.",
   "start": 10.42,
   "end": 11.83,
   "clip": "s02_2_ASHA.wav"
  },
  {
   "char": "LUIS",
   "text": "It learned from you.",
   "start": 12.4,
   "end": 13.551,
   "clip": "s02_3_LUIS.wav"
  },
  {
   "char": "NOOR",
   "text": "So all our food grows here now?",
   "start": 23.4,
   "end": 25.266,
   "clip": "s04_0_NOOR.wav"
  },
  {
   "char": "ASHA",
   "text": "Nope. Just the greens that like it here.",
   "start": 26.2,
   "end": 29.08,
   "clip": "s04_1_ASHA.wav"
  },
  {
   "char": "COLLEAGUE",
   "text": "Protein... from microbes?",
   "start": 31.4,
   "end": 33.597,
   "clip": "s05_0_COLLEAGUE.wav"
  },
  {
   "char": "MAYA",
   "text": "Yogurt is microbes.",
   "start": 33.947,
   "end": 35.278,
   "clip": "s05_1_MAYA.wav"
  },
  {
   "char": "COLLEAGUE",
   "text": "Fair.",
   "start": 36.2,
   "end": 36.819,
   "clip": "s05_2_COLLEAGUE.wav"
  },
  {
   "char": "LUIS",
   "text": "The school kitchen needs two crates by noon.",
   "start": 39.0,
   "end": 41.809,
   "clip": "s06_0_LUIS.wav"
  },
  {
   "char": "WORKER",
   "text": "Those were marked surplus.",
   "start": 42.4,
   "end": 43.911,
   "clip": "s06_1_WORKER.wav"
  },
  {
   "char": "LUIS",
   "text": "Then route them to dinner.",
   "start": 44.6,
   "end": 46.008,
   "clip": "s06_2_LUIS.wav"
  },
  {
   "char": "VENDOR",
   "text": "Not the prettiest batch.",
   "start": 49.2,
   "end": 50.604,
   "clip": "s07_0_VENDOR.wav"
  },
  {
   "char": "COOK",
   "text": "Good thing we're cooking it.",
   "start": 51.6,
   "end": 53.073,
   "clip": "s07_1_COOK.wav"
  },
  {
   "char": "NOOR",
   "text": "So this came from the farm?",
   "start": 57.5,
   "end": 59.119,
   "clip": "s08_0_NOOR.wav"
  },
  {
   "char": "ASHA",
   "text": "That, the greenhouse, and about six people you didn't see.",
   "start": 60.1,
   "end": 62.932,
   "clip": "s08_1_ASHA.wav"
  },
  {
   "char": "NOOR",
   "text": "And the scraps?",
   "start": 66.7,
   "end": 67.733,
   "clip": "s09_0_NOOR.wav"
  },
  {
   "char": "ASHA",
   "text": "Back to the soil.",
   "start": 68.7,
   "end": 69.838,
   "clip": "s09_1_ASHA.wav"
  },
  {
   "char": "NOOR",
   "text": "Okay. Not ugly.",
   "start": 74.9,
   "end": 76.974,
   "clip": "s10_0_NOOR.wav"
  },
  {
   "char": "ASHA",
   "text": "High praise.",
   "start": 77.4,
   "end": 78.422,
   "clip": "s10_1_ASHA.wav"
  }
 ],
