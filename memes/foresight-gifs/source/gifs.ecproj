                      "match": "sourceText",
                      "name": "Source Text",
                      "value": {
                        "t": "Text",
                        "v": {
                          "text": "1988",
                          "font": "Inter",
                          "style": "Medium",
                          "size": 32.0,
                          "fill": [
                            0.22745098,
                            0.2901961,
                            0.36862746,
                            1.0
                          ],
                          "stroke": [
                            0.0,
                            0.0,
                            0.0,
                            1.0
                          ],
                          "stroke_width": 0.0,
                          "apply_fill": true,
