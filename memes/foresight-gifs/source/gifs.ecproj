                          "indent_first": 0.0,
                          "space_before": 0.0,
                          "space_after": 0.0,
                          "direction": "Ltr",
                          "composer": "EveryLine",
                          "hanging_punctuation": false,
                          "vertical": false
                        }
                      },
                      "expr": {
                        "text": "var p=Math.min(1,Math.max(0,(time-0.4)/(3.2-0.4))); p=1-Math.pow(1-p,3);var c=Math.exp(Math.log(350000)+p*(Math.log(99)-Math.log(350000)));var k=Math.max(0,(1-c/350000)*100); (k>99.9?k.toFixed(2):k.toFixed(1))+\"%\"",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Text"
                      },
                      "spatial": false,
                      "hold_only": true,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 0,
                      "static_only": false
