                          "direction": "Ltr",
                          "composer": "EveryLine",
                          "hanging_punctuation": false,
                          "vertical": false
                        }
                      },
                      "expr": {
                        "text": "var p=Math.min(1,Math.max(0,(time-0.4)/(3.2-0.4))); p=1-Math.pow(1-p,3);function f(n){return Math.round(n).toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");}var c=f(Math.exp(Math.log(350000)+p*(Math.log(99)-Math.log(350000)))); time<0.4?\"1988: 350,000 cases a year\":(time<3.2?\"cases a year: \"+c:\"2024: 99 cases\")",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Text"
                      },
                      "spatial": false,
                      "hold_only": true,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 0,
                      "static_only": false
