# Copy to .env and export before running (the scanner reads the environment;
# it does not load .env itself). Nothing here is a signing key: this cycle has
# no execution path and never reads a private key.

# Base RPC endpoint(s), comma-separated, tried in order with failover.
# Unset = the public https://mainnet.base.org, which is rate-limited.
BASE_RPC_URL=

# Optional: POST alerts as JSON to this URL (Slack / Discord-compatible `text`/`content`).
ALERT_WEBHOOK_URL=

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 to engage the kill switch (same effect as `touch data/KILL`).
KILL_SWITCH=
